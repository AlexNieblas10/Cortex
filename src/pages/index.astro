---
export const prerender = false

import Icon from '../components/Icon.astro'
import {
	COMPANY,
	PRODUCT,
	PRICING,
	UI,
	PAYMENT_ERROR,
	HERO_STATS,
	STRIP_FEATURES,
	USE_CASES,
	SPECS,
	PROTECTIONS,
	GALLERY,
	SPECS_IMAGES,
	NAV_LINKS
} from '../config'
---

<!doctype html>
<html lang='en'>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1.0' />
		<title>{PRODUCT.name} — {COMPANY.name}</title>
		<meta name='description' content={PRODUCT.metaDesc} />
		<style>
			*,
			*::before,
			*::after {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}
			:root {
				--bg: #080c14;
				--bg2: #0d1220;
				--bg3: #111827;
				--border: rgba(255, 255, 255, 0.07);
				--accent: #3b82f6;
				--accent2: #1d4ed8;
				--accent-glow: rgba(59, 130, 246, 0.25);
				--text: #f1f5f9;
				--muted: #94a3b8;
				--success: #10b981;
				--radius: 12px;
				--radius-lg: 20px;
			}
			html {
				scroll-behavior: smooth;
			}
			body {
				font-family:
					-apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
				background: var(--bg);
				color: var(--text);
				line-height: 1.6;
				overflow-x: hidden;
			}
			a {
				color: inherit;
				text-decoration: none;
			}
			img {
				max-width: 100%;
				display: block;
			}
			button {
				cursor: pointer;
				font-family: inherit;
				border: none;
			}

			nav {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 100;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0 2rem;
				height: 64px;
				background: rgba(8, 12, 20, 0.88);
				backdrop-filter: blur(16px);
				border-bottom: 1px solid var(--border);
			}
			.nav-logo {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}
			.nav-logo-badge {
				width: 36px;
				height: 36px;
				border-radius: 8px;
				background: var(--accent);
				display: flex;
				align-items: center;
				justify-content: center;
				font-weight: 900;
				font-size: 0.8rem;
				color: #fff;
				letter-spacing: -0.5px;
			}
			.nav-logo-text {
				font-size: 0.95rem;
				font-weight: 600;
			}
			.nav-logo-sub {
				font-size: 0.7rem;
				color: var(--muted);
			}
			.nav-links {
				display: flex;
				gap: 2rem;
				font-size: 0.85rem;
				color: var(--muted);
			}
			.nav-links a:hover {
				color: var(--text);
			}
			.nav-cta {
				padding: 0.5rem 1.25rem;
				background: var(--accent);
				color: #fff;
				border-radius: 8px;
				font-size: 0.85rem;
				font-weight: 600;
				transition: background 0.2s;
			}
			.nav-cta:hover {
				background: var(--accent2);
			}
			@media (max-width: 768px) {
				.nav-links {
					display: none;
				}
			}

			.hero {
				min-height: 100vh;
				padding-top: 64px;
				display: flex;
				flex-direction: column;
				background: radial-gradient(
					ellipse 80% 60% at 50% 0%,
					rgba(59, 130, 246, 0.12) 0%,
					transparent 70%
				);
				position: relative;
				overflow: hidden;
			}
			.hero::before {
				content: '';
				position: absolute;
				inset: 0;
				pointer-events: none;
				background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%233b82f6' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/svg%3E");
			}
			.hero-inner {
				flex: 1;
				display: grid;
				grid-template-columns: 1fr 1fr;
				align-items: center;
				gap: 4rem;
				max-width: 1280px;
				margin: 0 auto;
				padding: 6rem 2rem 4rem;
				width: 100%;
			}
			.hero-label {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				background: rgba(59, 130, 246, 0.12);
				border: 1px solid rgba(59, 130, 246, 0.3);
				color: #60a5fa;
				padding: 0.3rem 0.85rem;
				border-radius: 999px;
				font-size: 0.75rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				margin-bottom: 1.5rem;
			}
			.hero-label-dot {
				width: 6px;
				height: 6px;
				background: #60a5fa;
				border-radius: 50%;
				flex-shrink: 0;
			}
			.hero-title {
				font-size: clamp(2.5rem, 5vw, 4rem);
				font-weight: 800;
				line-height: 1.1;
				letter-spacing: -0.03em;
				margin-bottom: 1.5rem;
			}
			.hero-title span {
				color: var(--accent);
			}
			.hero-desc {
				font-size: 1.1rem;
				color: var(--muted);
				max-width: 480px;
				margin-bottom: 2.5rem;
				line-height: 1.8;
			}
			.hero-actions {
				display: flex;
				gap: 1rem;
				flex-wrap: wrap;
			}
			.btn-primary {
				padding: 0.9rem 2rem;
				background: var(--accent);
				color: #fff;
				border-radius: var(--radius);
				font-size: 1rem;
				font-weight: 700;
				transition:
					background 0.2s,
					transform 0.1s,
					box-shadow 0.2s;
			}
			.btn-primary:hover {
				background: var(--accent2);
				box-shadow: 0 0 24px var(--accent-glow);
				transform: translateY(-1px);
			}
			.btn-secondary {
				padding: 0.9rem 2rem;
				background: transparent;
				color: var(--text);
				border-radius: var(--radius);
				font-size: 1rem;
				font-weight: 600;
				border: 1px solid var(--border);
				transition:
					border-color 0.2s,
					background 0.2s;
			}
			.btn-secondary:hover {
				border-color: var(--accent);
				background: rgba(59, 130, 246, 0.06);
			}
			.hero-stats {
				display: flex;
				gap: 2.5rem;
				margin-top: 3rem;
				padding-top: 2rem;
				border-top: 1px solid var(--border);
			}
			.stat-val {
				font-size: 1.6rem;
				font-weight: 800;
			}
			.stat-label {
				font-size: 0.78rem;
				color: var(--muted);
				margin-top: 0.2rem;
			}
			.hero-visual {
				position: relative;
			}
			.hero-image-wrap {
				border-radius: var(--radius-lg);
				overflow: hidden;
				border: 1px solid var(--border);
				box-shadow:
					0 40px 100px rgba(0, 0, 0, 0.6),
					0 0 60px var(--accent-glow);
				background: #0d1220;
			}
			.hero-image-wrap img {
				width: 100%;
				aspect-ratio: 16/9;
				object-fit: cover;
			}
			.hero-badge {
				position: absolute;
				top: -16px;
				right: -16px;
				background: var(--accent);
				color: #fff;
				padding: 0.5rem 1rem;
				border-radius: 999px;
				font-size: 0.8rem;
				font-weight: 700;
				box-shadow: 0 4px 20px rgba(59, 130, 246, 0.4);
			}
			.hero-chip {
				position: absolute;
				bottom: -16px;
				left: 24px;
				background: var(--bg3);
				border: 1px solid var(--border);
				padding: 0.75rem 1.25rem;
				border-radius: var(--radius);
				display: flex;
				align-items: center;
				gap: 0.75rem;
				box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
			}
			.chip-dot {
				width: 8px;
				height: 8px;
				background: var(--success);
				border-radius: 50%;
				animation: pulse 2s infinite;
				flex-shrink: 0;
			}
			@keyframes pulse {
				0%,
				100% {
					opacity: 1;
				}
				50% {
					opacity: 0.4;
				}
			}
			.chip-text {
				font-size: 0.8rem;
				font-weight: 600;
			}
			.chip-sub {
				font-size: 0.7rem;
				color: var(--muted);
			}
			@media (max-width: 900px) {
				.hero-inner {
					grid-template-columns: 1fr;
					gap: 3rem;
					padding: 5rem 1.5rem 3rem;
				}
				.hero-visual {
					order: -1;
				}
				.hero-badge {
					top: -12px;
					right: -4px;
				}
			}

			.features-strip {
				border-top: 1px solid var(--border);
				border-bottom: 1px solid var(--border);
				background: var(--bg2);
				padding: 1.25rem 2rem;
			}
			.features-strip-inner {
				max-width: 1280px;
				margin: 0 auto;
				display: flex;
				gap: 3rem;
				align-items: center;
				flex-wrap: wrap;
				justify-content: center;
			}
			.strip-item {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				font-size: 0.85rem;
				white-space: nowrap;
			}
			.strip-icon {
				color: var(--accent);
				display: flex;
				align-items: center;
			}
			.strip-label {
				color: var(--muted);
			}
			.strip-val {
				font-weight: 600;
			}

			.section {
				padding: 6rem 2rem;
			}
			.section-inner {
				max-width: 1280px;
				margin: 0 auto;
			}
			.section-tag {
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: var(--accent);
				margin-bottom: 0.75rem;
			}
			.section-title {
				font-size: clamp(1.8rem, 3vw, 2.5rem);
				font-weight: 800;
				line-height: 1.2;
				margin-bottom: 1rem;
				letter-spacing: -0.02em;
			}
			.section-desc {
				font-size: 1rem;
				color: var(--muted);
				max-width: 600px;
				line-height: 1.8;
			}

			.gallery-section {
				background: var(--bg2);
			}
			.gallery-tabs {
				display: flex;
				gap: 0.75rem;
				margin-top: 2.5rem;
				margin-bottom: 2rem;
			}
			.tab-btn {
				padding: 0.6rem 1.25rem;
				border-radius: var(--radius);
				font-size: 0.85rem;
				font-weight: 600;
				background: transparent;
				color: var(--muted);
				border: 1px solid var(--border);
				transition: all 0.2s;
			}
			.tab-btn.active,
			.tab-btn:hover {
				background: var(--accent);
				color: #fff;
				border-color: var(--accent);
			}
			.gallery-main {
				border-radius: var(--radius-lg);
				overflow: hidden;
				border: 1px solid var(--border);
				box-shadow: 0 20px 80px rgba(0, 0, 0, 0.5);
				background: var(--bg3);
			}
			.gallery-main img {
				width: 100%;
				max-height: 520px;
				object-fit: cover;
				transition: opacity 0.3s;
			}
			.gallery-thumbs {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1rem;
				margin-top: 1rem;
			}
			.thumb {
				border-radius: var(--radius);
				overflow: hidden;
				border: 2px solid transparent;
				cursor: pointer;
				transition: border-color 0.2s;
				background: var(--bg3);
			}
			.thumb.active {
				border-color: var(--accent);
			}
			.thumb img {
				width: 100%;
				aspect-ratio: 16/9;
				object-fit: cover;
			}

			.use-cases-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.5rem;
				margin-top: 3rem;
			}
			.use-card {
				background: var(--bg2);
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				padding: 1.75rem;
				transition:
					border-color 0.2s,
					transform 0.2s;
			}
			.use-card:hover {
				border-color: rgba(59, 130, 246, 0.4);
				transform: translateY(-4px);
			}
			.use-icon {
				width: 44px;
				height: 44px;
				border-radius: 10px;
				background: rgba(59, 130, 246, 0.1);
				border: 1px solid rgba(59, 130, 246, 0.15);
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--accent);
				margin-bottom: 1.1rem;
			}
			.use-title {
				font-size: 1rem;
				font-weight: 700;
				margin-bottom: 0.5rem;
			}
			.use-desc {
				font-size: 0.875rem;
				color: var(--muted);
				line-height: 1.7;
			}

			.specs-section {
				background: var(--bg);
			}
			.specs-layout {
				display: grid;
				grid-template-columns: 1fr 1.5fr;
				gap: 4rem;
				align-items: start;
				margin-top: 3rem;
			}
			.specs-table {
				width: 100%;
				border-collapse: collapse;
			}
			.specs-table tr {
				border-bottom: 1px solid var(--border);
			}
			.specs-table tr:last-child {
				border-bottom: none;
			}
			.specs-table td {
				padding: 0.85rem 0.5rem;
				font-size: 0.875rem;
				vertical-align: top;
			}
			.specs-table td:first-child {
				color: var(--muted);
				white-space: nowrap;
				padding-right: 1.5rem;
				font-weight: 500;
				width: 40%;
			}
			.specs-table td:last-child {
				color: var(--text);
				font-weight: 500;
			}
			.specs-image-side {
				position: sticky;
				top: 80px;
			}
			.specs-image-card {
				border-radius: var(--radius-lg);
				overflow: hidden;
				border: 1px solid var(--border);
				background: var(--bg3);
				box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
			}
			.specs-image-card img {
				width: 100%;
				aspect-ratio: 16/9;
				object-fit: cover;
			}
			.specs-callout {
				margin-top: 1.5rem;
				background: rgba(59, 130, 246, 0.08);
				border: 1px solid rgba(59, 130, 246, 0.2);
				border-radius: var(--radius);
				padding: 1.25rem 1.5rem;
			}
			.specs-callout p {
				font-size: 0.875rem;
				color: var(--muted);
				line-height: 1.7;
			}
			.specs-callout strong {
				color: var(--text);
			}
			@media (max-width: 900px) {
				.specs-layout {
					grid-template-columns: 1fr;
					gap: 2rem;
				}
				.specs-image-side {
					position: relative;
					top: 0;
				}
			}

			.prot-section-tag {
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: var(--accent);
				margin-top: 2.5rem;
				margin-bottom: 1rem;
			}
			.prot-grid {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
			}
			.prot-badge {
				display: flex;
				align-items: center;
				gap: 0.4rem;
				background: var(--bg3);
				border: 1px solid var(--border);
				border-radius: 999px;
				padding: 0.45rem 1rem;
				font-size: 0.8rem;
				font-weight: 500;
				color: var(--text);
			}
			.prot-badge-icon {
				color: var(--success);
				display: flex;
				align-items: center;
			}

			.cta-section {
				background: linear-gradient(
					135deg,
					rgba(59, 130, 246, 0.15) 0%,
					rgba(29, 78, 216, 0.08) 100%
				);
				border-top: 1px solid var(--border);
				text-align: center;
				padding: 7rem 2rem;
			}
			.cta-inner {
				max-width: 700px;
				margin: 0 auto;
			}
			.cta-title {
				font-size: clamp(2rem, 4vw, 3rem);
				font-weight: 800;
				margin-bottom: 1rem;
				letter-spacing: -0.03em;
			}
			.cta-desc {
				color: var(--muted);
				font-size: 1.05rem;
				margin-bottom: 2.5rem;
				line-height: 1.8;
			}
			.cta-price {
				font-size: 3rem;
				font-weight: 900;
				color: var(--accent);
				margin-bottom: 0.25rem;
				letter-spacing: -0.04em;
			}
			.cta-price-note {
				font-size: 0.85rem;
				color: var(--muted);
				margin-bottom: 2rem;
			}
			#btn-comprar {
				padding: 1.1rem 3rem;
				background: var(--accent);
				color: #fff;
				border-radius: var(--radius);
				font-size: 1.1rem;
				font-weight: 800;
				transition: all 0.2s;
				box-shadow: 0 0 0 0 var(--accent-glow);
			}
			#btn-comprar:hover:not(:disabled) {
				background: var(--accent2);
				transform: translateY(-2px);
				box-shadow: 0 8px 32px var(--accent-glow);
			}
			#btn-comprar:disabled {
				opacity: 0.6;
				cursor: not-allowed;
			}
			.cta-guarantee {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.5rem;
				margin-top: 1.5rem;
				font-size: 0.8rem;
				color: var(--muted);
			}
			.cta-guarantee-icon {
				color: var(--success);
				display: flex;
				align-items: center;
			}

			.modal-overlay {
				position: fixed;
				inset: 0;
				z-index: 999;
				background: rgba(0, 0, 0, 0.75);
				backdrop-filter: blur(4px);
				display: none;
				align-items: center;
				justify-content: center;
				padding: 1rem;
			}
			.modal-overlay.open {
				display: flex;
			}
			.modal {
				background: var(--bg3);
				border: 1px solid rgba(239, 68, 68, 0.3);
				border-radius: var(--radius-lg);
				padding: 2.5rem;
				max-width: 420px;
				width: 100%;
				text-align: center;
				box-shadow:
					0 24px 80px rgba(0, 0, 0, 0.6),
					0 0 60px rgba(239, 68, 68, 0.1);
				animation: slideUp 0.25s ease;
			}
			@keyframes slideUp {
				from {
					opacity: 0;
					transform: translateY(20px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}
			.modal-icon-wrap {
				width: 64px;
				height: 64px;
				border-radius: 50%;
				background: rgba(239, 68, 68, 0.1);
				border: 1px solid rgba(239, 68, 68, 0.2);
				display: flex;
				align-items: center;
				justify-content: center;
				margin: 0 auto 1.5rem;
				color: #ef4444;
			}
			.modal-title {
				font-size: 1.2rem;
				font-weight: 700;
				margin-bottom: 0.75rem;
			}
			.modal-body {
				font-size: 0.9rem;
				color: var(--muted);
				line-height: 1.7;
				margin-bottom: 0.75rem;
			}
			.modal-code {
				display: inline-block;
				background: rgba(239, 68, 68, 0.1);
				color: #fca5a5;
				border: 1px solid rgba(239, 68, 68, 0.2);
				border-radius: 6px;
				padding: 0.2rem 0.6rem;
				font-family: monospace;
				font-size: 0.8rem;
				margin-bottom: 1.75rem;
			}
			.modal-actions {
				display: flex;
				gap: 0.75rem;
				justify-content: center;
			}
			.modal-dismiss {
				padding: 0.65rem 1.5rem;
				background: transparent;
				color: var(--muted);
				border-radius: 8px;
				font-size: 0.9rem;
				font-weight: 600;
				border: 1px solid var(--border);
				transition: all 0.2s;
			}
			.modal-dismiss:hover {
				color: var(--text);
				border-color: rgba(255, 255, 255, 0.2);
			}

			footer {
				border-top: 1px solid var(--border);
				background: var(--bg2);
				padding: 3rem 2rem;
			}
			.footer-inner {
				max-width: 1280px;
				margin: 0 auto;
				display: flex;
				align-items: center;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 1.5rem;
			}
			.footer-brand strong {
				font-size: 1rem;
			}
			.footer-brand p {
				color: var(--muted);
				font-size: 0.8rem;
				margin-top: 0.25rem;
			}
			.footer-links {
				display: flex;
				gap: 2rem;
				font-size: 0.82rem;
				color: var(--muted);
			}
			.footer-links a:hover {
				color: var(--text);
			}
			.footer-copy {
				font-size: 0.78rem;
				color: var(--muted);
			}

			@media (max-width: 600px) {
				.footer-inner {
					flex-direction: column;
					align-items: flex-start;
				}
				.hero-stats {
					gap: 1.5rem;
					flex-wrap: wrap;
				}
				.gallery-thumbs {
					gap: 0.5rem;
				}
			}
		</style>
	</head>
	<body>
		<!-- ===== NAV ===== -->
		<nav>
			<div class='nav-logo'>
				<div class='nav-logo-badge'>{COMPANY.initials}</div>
				<div>
					<div class='nav-logo-text'>{COMPANY.name}</div>
					<div class='nav-logo-sub'>Industrial Edge Computing</div>
				</div>
			</div>
			<div class='nav-links'>
				{NAV_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
			</div>
			<a href='#cta' class='nav-cta'>{UI.btnQuote}</a>
		</nav>

		<!-- ===== HERO ===== -->
		<section class='hero'>
			<div class='hero-inner'>
				<div class='hero-content'>
					<div class='hero-label'>
						<span class='hero-label-dot'></span>
						{PRODUCT.generation}
					</div>
					<h1 class='hero-title'>
						{PRODUCT.shortName}
						<span>{PRODUCT.version}</span><br />
						{PRODUCT.tagline}
					</h1>
					<p class='hero-desc'>{PRODUCT.description}</p>
					<div class='hero-actions'>
						<button class='btn-primary' id='btn-hero-buy'>{UI.btnBuy}</button>
						<a href='#specs' class='btn-secondary'>{UI.btnSpecs}</a>
					</div>
					<div class='hero-stats'>
						{
							HERO_STATS.map((s) => (
								<div>
									<div class='stat-val'>{s.val}</div>
									<div class='stat-label'>{s.label}</div>
								</div>
							))
						}
					</div>
				</div>

				<div class='hero-visual'>
					<span class='hero-badge'>{PRODUCT.badgeLabel}</span>
					<div class='hero-image-wrap'>
						<img src={GALLERY[0].src} alt={GALLERY[0].alt} />
					</div>
					<div class='hero-chip'>
						<div class='chip-dot'></div>
						<div>
							<div class='chip-text'>{PRODUCT.chipStatus}</div>
							<div class='chip-sub'>{PRODUCT.chipSub}</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ===== FEATURES STRIP ===== -->
		<div class='features-strip'>
			<div class='features-strip-inner'>
				{
					STRIP_FEATURES.map((f) => (
						<div class='strip-item'>
							<span class='strip-icon'>
								<Icon name={f.icon} size={16} />
							</span>
							<span class='strip-val'>{f.val}</span>
							<span class='strip-label'>&nbsp;{f.label}</span>
						</div>
					))
				}
			</div>
		</div>

		<!-- ===== GALLERY ===== -->
		<section class='section gallery-section' id='gallery'>
			<div class='section-inner'>
				<div class='section-tag'>Industrial design</div>
				<h2 class='section-title'>Built to last</h2>
				<p class='section-desc'>
					Rugged enclosure with industrial connectors, full electrical
					protection on all peripherals and active thermal management designed
					to operate in extreme conditions.
				</p>
				<div class='gallery-tabs'>
					{
						GALLERY.map((g, i) => (
							<button
								class:list={['tab-btn', { active: i === 0 }]}
								data-img={g.src}>
								{g.label}
							</button>
						))
					}
				</div>
				<div class='gallery-main'>
					<img id='gallery-img' src={GALLERY[0].src} alt={GALLERY[0].alt} />
				</div>
				<div class='gallery-thumbs'>
					{
						GALLERY.map((g, i) => (
							<div class:list={['thumb', { active: i === 0 }]} data-img={g.src}>
								<img src={g.src} alt={g.alt} />
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- ===== APPLICATIONS ===== -->
		<section class='section' id='applications'>
			<div class='section-inner'>
				<div class='section-tag'>Use cases</div>
				<h2 class='section-title'>Powering every industry</h2>
				<p class='section-desc'>
					From vehicle fleets to industrial plants, the {PRODUCT.name} adapts to any
					scenario demanding reliable edge processing and remote connectivity.
				</p>
				<div class='use-cases-grid'>
					{
						USE_CASES.map((u) => (
							<div class='use-card'>
								<div class='use-icon'>
									<Icon name={u.icon} size={22} />
								</div>
								<div class='use-title'>{u.title}</div>
								<div class='use-desc'>{u.desc}</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- ===== SPECS ===== -->
		<section class='section specs-section' id='specs'>
			<div class='section-inner'>
				<div class='section-tag'>Technical datasheet</div>
				<h2 class='section-title'>Full specifications</h2>
				<p class='section-desc'>
					Every component selected for maximum performance in mission-critical
					applications.
				</p>

				<div class='specs-layout'>
					<div>
						<table class='specs-table'>
							{
								SPECS.map((s) => (
									<tr>
										<td>{s.label}</td>
										<td>{s.value}</td>
									</tr>
								))
							}
						</table>

						<div class='prot-section-tag'>Electrical protections</div>
						<div class='prot-grid'>
							{
								PROTECTIONS.map((p) => (
									<span class='prot-badge'>
										<span class='prot-badge-icon'>
											<Icon name='check' size={13} />
										</span>
										{p}
									</span>
								))
							}
						</div>
					</div>

					<div class='specs-image-side'>
						<div class='specs-image-card'>
							<img src={SPECS_IMAGES[0].src} alt={SPECS_IMAGES[0].alt} />
						</div>
						<div class='specs-callout'>
							<p>
								<strong>Designed for mobile and industrial environments.</strong
								> The 9–36 VDC power input supports 12 V and 24 V systems natively
								without additional converters. An auxiliary MCU handles sequential
								subsystem startup and executes PowerSave sleep in under 200 ms, extending
								battery life in mobile installations.
							</p>
						</div>
						<div class='specs-image-card' style='margin-top:1rem;'>
							<img src={SPECS_IMAGES[1].src} alt={SPECS_IMAGES[1].alt} />
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ===== CTA ===== -->
		<section class='cta-section' id='cta'>
			<div class='cta-inner'>
				<div class='section-tag'>{PRICING.availabilityLabel}</div>
				<h2 class='cta-title'>{PRICING.ctaTitle}</h2>
				<p class='cta-desc'>{PRICING.ctaDesc}</p>
				<div class='cta-price'>{PRICING.amount}</div>
				<div class='cta-price-note'>{PRICING.note}</div>
				<button id='btn-comprar'>{UI.btnBuy}</button>
				<p class='cta-guarantee'>
					<span class='cta-guarantee-icon'
						><Icon name='shield' size={14} /></span
					>
					{PRICING.warranty}
				</p>
			</div>
		</section>

		<!-- ===== FOOTER ===== -->
		<footer>
			<div class='footer-inner'>
				<div class='footer-brand'>
					<strong>{COMPANY.name}</strong>
					<p>{COMPANY.tagline}</p>
				</div>
				<div class='footer-links'>
					{NAV_LINKS.slice(0, 3).map((l) => <a href={l.href}>{l.label}</a>)}
				</div>
				<div class='footer-copy'>
					&copy; {COMPANY.copyright}
					{COMPANY.name}. All rights reserved.
				</div>
			</div>
		</footer>

		<!-- ===== ERROR MODAL ===== -->
		<div class='modal-overlay' id='modal-overlay'>
			<div
				class='modal'
				role='alertdialog'
				aria-modal='true'
				aria-labelledby='modal-title'>
				<div class='modal-icon-wrap'>
					<Icon name='alert-triangle' size={32} />
				</div>
				<h3 class='modal-title' id='modal-title'>{PAYMENT_ERROR.title}</h3>
				<p class='modal-body'>{PAYMENT_ERROR.body}</p>
				<code class='modal-code'>{PAYMENT_ERROR.code}</code>
				<div class='modal-actions'>
					<button class='modal-dismiss' id='modal-dismiss'
						>{UI.btnCancel}</button
					>
				</div>
			</div>
		</div>

		<script>
			fetch('/api/track', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ action: 'page_view', timestamp: Date.now() })
			}).catch(() => {})

			const galleryImg = document.getElementById(
				'gallery-img'
			) as HTMLImageElement
			const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn')
			const thumbs = document.querySelectorAll<HTMLDivElement>('.thumb')

			function switchImage(src: string) {
				galleryImg.style.opacity = '0'
				setTimeout(() => {
					galleryImg.src = src
					galleryImg.style.opacity = '1'
				}, 150)
				tabs.forEach((t) => t.classList.toggle('active', t.dataset.img === src))
				thumbs.forEach((t) =>
					t.classList.toggle('active', t.dataset.img === src)
				)
			}

			tabs.forEach((tab) =>
				tab.addEventListener('click', () => switchImage(tab.dataset.img!))
			)
			thumbs.forEach((thumb) =>
				thumb.addEventListener('click', () => switchImage(thumb.dataset.img!))
			)

			const buyBtn = document.getElementById('btn-comprar') as HTMLButtonElement
			const heroBuyBtn = document.getElementById(
				'btn-hero-buy'
			) as HTMLButtonElement
			const overlay = document.getElementById('modal-overlay') as HTMLDivElement
			const modalDismiss = document.getElementById(
				'modal-dismiss'
			) as HTMLButtonElement

			async function handleBuy() {
				buyBtn.disabled = true
				buyBtn.textContent = 'Procesando...'

				try {
					await fetch('/api/track', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ action: 'buy_click', timestamp: Date.now() })
					})
				} catch (_) {}

				setTimeout(() => {
					buyBtn.disabled = false
					buyBtn.textContent = 'Buy now'
					overlay.classList.add('open')
				}, 1400)
			}

			buyBtn.addEventListener('click', handleBuy)
			heroBuyBtn.addEventListener('click', () => {
				document.getElementById('cta')?.scrollIntoView({ behavior: 'smooth' })
				setTimeout(handleBuy, 600)
			})

			modalDismiss.addEventListener('click', () =>
				overlay.classList.remove('open')
			)
			overlay.addEventListener('click', (e) => {
				if (e.target === overlay) overlay.classList.remove('open')
			})
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') overlay.classList.remove('open')
			})
		</script>
	</body>
</html>
